<Project>
    <PropertyGroup>
        <Authors>Thomas Waters</Authors>
        <Copyright>Thomas Waters</Copyright>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageLicense>MIT</PackageLicense>
        <RepositoryType>git</RepositoryType>
        <NeutralLanguage>en-US</NeutralLanguage>
        <PackageProjectUrl>https://evelios.github.io/Math.Units/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Evelios/Math.Units</RepositoryUrl>
        <FsDocsLicenseLink>https://opensource.org/licenses/MIT</FsDocsLicenseLink>
        <FsDocsReleaseNotesLink>https://github.com/Evelios/Math.Units/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>
        <FsDocsWarnOnMissingDocs>true</FsDocsWarnOnMissingDocs>
        <FsDocsTheme>default</FsDocsTheme>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
