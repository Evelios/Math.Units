<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>Units</RootNamespace>

        <Product>Math.Units</Product>
        <Description>A functional-first units of measurement library for F# and Fable.</Description>
        <PackageTags>math, units, fsharp, f#, fable, fable-library</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Extensions\TupleExtensions.fs"/>
        <Compile Include="Float.fs"/>
        <Compile Include="Types.fs"/>
        <Compile Include="Quantity.fs"/>
        <Compile Include="Constants.fs"/>
        <Compile Include="Angle.fs"/>
        <Compile Include="Interval.fs"/>
        <Compile Include="Duration.fs"/>
        <Compile Include="Length.fs"/>
        <Compile Include="Area.fs"/>
        <Compile Include="Volume.fs"/>
        <Compile Include="Pixels.fs"/>
        <Compile Include="Speed.fs"/>
        <Compile Include="SolidAngle.fs"/>
        <Compile Include="Acceleration.fs"/>
        <Compile Include="AngularSpeed.fs"/>
        <Compile Include="AngularAcceleration.fs"/>
        <Compile Include="Mass.fs"/>
        <Compile Include="Density.fs"/>
        <Compile Include="Force.fs"/>
        <Compile Include="Energy.fs"/>
        <Compile Include="Pressure.fs"/>
        <Compile Include="LuminousFlux.fs"/>
        <Compile Include="Illuminance.fs"/>
        <Compile Include="Inductance.fs"/>
        <Compile Include="LuminousIntensity.fs"/>
        <Compile Include="Luminance.fs"/>
        <Compile Include="SubstanceAmount.fs"/>
        <Compile Include="Molarity.fs"/>
        <Compile Include="Charge.fs"/>
        <Compile Include="Current.fs"/>
        <Compile Include="Power.fs"/>
        <Compile Include="Capacitance.fs"/>
        <Compile Include="Resistance.fs"/>
        <Compile Include="Voltage.fs"/>
        <Compile Include="Temperature.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="7.0.400"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**"/>
        <EmbeddedResource Remove="bin\**"/>
    </ItemGroup>


    <!-- Add source files to "fable" folder in Nuget package -->
    <ItemGroup>
        <Content Include="*.fsproj; **\*.fs; **\*.fsi" PackagePath="fable\"/>
        <Content Remove="obj\**"/>
        <Content Remove="bin\**"/>
    </ItemGroup>

</Project>
