<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>Math.Units.Testing</RootNamespace>
        <Product>Math.Units.Testing</Product>
        <Description>Testing utilities and FsCheck generators for Math.Units.</Description>
        <PackageTags>math, units, fsharp, f#, testing, fscheck</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Test.fs" />
        <Compile Include="Gen.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FsCheck.NUnit" Version="2.16.6" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Update="FSharp.Core" Version="7.0.400" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Math.Units\Math.Units.fsproj" />
    </ItemGroup>

</Project>
